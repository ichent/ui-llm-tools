{
  "name": "@frontdrive/ui-llm-tools",
  "version": "0.1.0",
  "description": "Внутренний фреймворк AI-тулинга для frontend-команд: раскатывает skills/агентские инструкции в проекты через CLI-генератор.",
  "type": "module",
  "bin": {
    "frontdrive-tools": "bin/frontdrive-tools.js",
    "frontdrive-mcp": "bin/frontdrive-mcp.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin",
    "dist",
    "assets",
    "glossary-tools/glossary.json",
    "glossary-tools/overlay.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "skills",
    "agents",
    "frontend",
    "cli",
    "codegen"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
